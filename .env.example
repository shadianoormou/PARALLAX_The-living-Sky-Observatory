# Browser-visible web configuration
NEXT_PUBLIC_API_URL=http://localhost:5080
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
NEXT_PUBLIC_SCIENCE_URL=http://localhost:8001

# API / science service configuration
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=Parallax;User Id=sa;Password=replace-with-a-strong-local-password;TrustServerCertificate=True
ScienceService__BaseUrl=http://localhost:8001/
PARALLAX_CORS_ORIGINS=http://localhost:3000

# Docker Compose only. Keep this in .env, never commit the real password.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password
